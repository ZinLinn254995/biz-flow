    "id": "P2P23",
    "name": "Account Balance Updates",
    "objective": "Keep Account.balance in sync with the transactions that reference accountId, applied atomically alongside the transaction write.",
    "scope": [
      "src/services/businessExpenses/BusinessExpenseService.ts",
      "src/services/personalFinance/PersonalIncomeService.ts",
      "src/services/personalFinance/PersonalExpenseService.ts",
      "src/services/accounts/AccountService.ts",
      "src/services/container.ts"
    ],
    "acceptanceCriteria": [
      "Creating an expense that names an accountId decreases that account balance by the expense amount",
      "Creating an income that names an accountId increases that account balance",
      "Updating or deleting a transaction reverses the previous effect and applies the new one",
      "A transaction in a currency that differs from the account currency is rejected with ValidationError",
      "Balance changes and transaction writes are applied through the injected TransactionRunner port, never by importing @/db into a service",
      "New tests cover create, update and delete for both directions; all existing tests still pass",
      "npm run verify passes end to end",
      "No changes to locked files"
    ],
    "verificationCommands": [
      "npm run typecheck",
      "npm run test",
      "npm run build",
      "npm run verify:imports",
      "npm run verify:ai"
